#DB
POSTGRES_USER=postgres
POSTGRES_PASSWORD=senha
POSTGRES_DB=triiage_db
# só usado quando a API roda fora do Docker; dentro do compose vira "db"
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

#JEV
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
MIN_CONFIDENCE=0.7
# segundos esperando o JEV antes de classificar só pela árvore de decisão (contingência)
JEV_TIMEOUT=10

#API
CORS_ORIGINS=["http://localhost:3000"]
