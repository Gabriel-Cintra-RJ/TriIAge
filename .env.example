# Variáveis do front usadas pelo docker-compose da pasta TCC. Copie para .env e preencha.
# (as do banco e do JEV ficam em TriIAge-backend/.env)

# segredo do NextAuth. Para gerar um:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=

# senha das contas de demonstração (recepcao@, enfermagem@, medico@, auditoria@, gestao@ triiage.local)
AUTH_DEMO_PASSWORD=
