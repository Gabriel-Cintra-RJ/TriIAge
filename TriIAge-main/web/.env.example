# URL da API de triagem (FastAPI). No Docker, use http://host.docker.internal:8000
# se o microsserviço estiver rodando no host.
TRIAGE_API_URL=http://localhost:8000

# NextAuth: URL pública do front e segredo de assinatura do JWT.
# Gere o segredo com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Senha das contas de demonstração (paciente@, recepcao@, enfermagem@, medico@,
# auditoria@, gestao@ triiage.local). Vazia = login desativado.
AUTH_DEMO_PASSWORD=
