# .gitignore da raiz do monorepo (backend + frontend).
# Cada subprojeto ainda tem o seu; este aqui cobre a raiz e serve de rede de segurança para os dois.

.env
.env.*
!.env.example

# Python (backend)
.venv/
__pycache__/
*.py[oc]
.pytest_cache/
*.egg-info/
build/
dist/

# Node / Next.js (frontend)
node_modules/
.next/
out/
next-env.d.ts
*.tsbuildinfo
npm-debug.log*

# sistema e editores
.DS_Store
Thumbs.db
.vscode/
.idea/

# documentos do Word abertos geram esse arquivo temporário
~$*
